{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index-v2.html" },
    { "source": "/privacy-policy", "destination": "/index-v2.html" },
    { "source": "/terms-and-conditions", "destination": "/index-v2.html" },
    { "source": "/risk-disclaimer", "destination": "/index-v2.html" },
    { "source": "/commission-disclosure", "destination": "/index-v2.html" },
    { "source": "/grievance-redressal", "destination": "/index-v2.html" },
    { "source": "/registration-disclosure", "destination": "/index-v2.html" },
    { "source": "/investor-charter", "destination": "/index-v2.html" },
    { "source": "/kyc-onboarding", "destination": "/index-v2.html" },
    { "source": "/transaction-policy", "destination": "/index-v2.html" },
    { "source": "/fund-recommendation-policy", "destination": "/index-v2.html" },
    { "source": "/important-links", "destination": "/index-v2.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/clear-site-data.html",
      "headers": [
        {
          "key": "Clear-Site-Data",
          "value": "\"*\""
        }
      ]
    }
  ]
}
