{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "dest": "/index-v2.html"
    },
    {
      "src": "^/(privacy-policy|terms-and-conditions|risk-disclaimer|commission-disclosure|grievance-redressal|registration-disclosure|investor-charter|kyc-onboarding|transaction-policy|fund-recommendation-policy|important-links)/?$",
      "dest": "/index-v2.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?!assets/|clear-site-data\\.html$|index-v2\\.html$|index\\.html$)(.*)$",
      "dest": "/index-v2.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/clear-site-data.html",
      "headers": [
        {
          "key": "Clear-Site-Data",
          "value": "\"*\""
        }
      ]
    }
  ]
}
